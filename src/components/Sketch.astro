---
// A live sketch from projects/<project>/sketch.ts. Inside a project's index.mdx
// it's available without an import, e.g.
//   <Sketch project="flow-field" params={{ turbulence: 0.4 }} seed={7} />
interface Props {
  /** Folder name under projects/. */
  project: string
  /** Show the control panel. */
  controls?: boolean
  /** Keep the seed and params in the page URL. One per page. */
  syncUrl?: boolean
  /** Param overrides, e.g. to show one stage of an algorithm in a write-up. */
  params?: Record<string, unknown>
  seed?: number
}

const { project, controls = false, syncUrl = false, params, seed } = Astro.props
---

{/* The stage's height is relative to this element's width (cqi), via @container. */}
<sketch-view
  data-project={project}
  data-params={params && JSON.stringify(params)}
  data-seed={seed}
  data-sync-url={syncUrl ? '' : undefined}
  class:list={[
    'not-prose @container my-6 grid gap-4',
    controls && 'md:grid-cols-[minmax(0,1fr)_280px]',
  ]}
>
  <div
    data-stage
    class="grid h-[min(74vh,100cqi)] place-items-center overflow-hidden rounded-lg bg-surface md:h-[min(74vh,75cqi)] data-error:p-4 data-error:font-mono data-error:whitespace-pre-wrap data-error:text-red-300"
  ></div>
  {controls && <div data-panel class="self-start"></div>}
</sketch-view>

<script>
  import '@/lib/elements'
</script>

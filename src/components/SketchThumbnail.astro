---
// One still frame of a sketch, rendered in the browser when scrolled into view.
interface Props {
  project: string
}
---

<sketch-thumbnail data-project={Astro.props.project}></sketch-thumbnail>

<script>
  import '@/lib/elements'
</script>

<style>
  sketch-thumbnail {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  sketch-thumbnail :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: fade-in 0.4s ease-out;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>

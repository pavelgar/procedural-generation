---
// One still frame of a sketch, rendered in the browser when scrolled into view.
interface Props {
  project: string
}
---

{/* The canvas and then the image are created by elements.ts, hence the [&_img] styles. */}
<sketch-thumbnail
  data-project={Astro.props.project}
  class="grid size-full place-items-center overflow-hidden [&_img]:size-full [&_img]:animate-in [&_img]:fade-in [&_img]:duration-400 [&_img]:ease-out [&_img]:object-cover"
></sketch-thumbnail>

<script>
  import '@/lib/elements'
</script>

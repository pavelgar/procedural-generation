---
import { Image } from 'astro:assets'
import SketchThumbnail from '@/components/SketchThumbnail.astro'
import Base from '@/layouts/Base.astro'
import { getProjects, hasSketch } from '@/lib/projects'
import { href, site } from '@/site'

const projects = await getProjects()
---

<Base>
  <p class="text-muted">{site.description}</p>

  <ul class="mt-10 grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-x-6 gap-y-8">
    {projects.map((project) => (
      <li>
        <a href={href(`${project.id}/`)} class="group block">
          <div class="aspect-3/2 overflow-hidden rounded-lg bg-surface transition-transform duration-200 ease-out group-hover:-translate-y-1">
            {project.data.cover ? (
              <Image
                src={project.data.cover}
                alt=""
                widths={[400, 800]}
                sizes="400px"
                class="size-full object-cover"
              />
            ) : (
              hasSketch(project) && <SketchThumbnail project={project.id} />
            )}
          </div>
          <h2 class="mt-3 mb-1 text-lg font-semibold">
            {project.data.title}
            {project.data.draft && <span class="text-sm font-normal text-muted">(draft)</span>}
          </h2>
          <p class="text-muted">{project.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</Base>

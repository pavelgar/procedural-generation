---
import type { InferGetStaticPropsType } from 'astro'
import { render } from 'astro:content'
import Sketch from '@/components/Sketch.astro'
import Base from '@/layouts/Base.astro'
import { getProjects, hasSketch } from '@/lib/projects'

export async function getStaticPaths() {
  const projects = await getProjects()
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { project } = Astro.props
const { title, description, date, tags } = project.data
const { Content } = await render(project)
---

<Base title={title} description={description}>
  <h1 class="mt-5 mb-1 text-3xl font-bold">{title}</h1>
  <p class="text-muted">
    <time datetime={date.toISOString()}>
      {date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
    </time>
    {tags.map((tag) => (
      <span class="ml-3 font-mono text-sm before:content-['#']">{tag}</span>
    ))}
  </p>

  {hasSketch(project) && <Sketch project={project.id} controls syncUrl />}

  <article class="prose prose-invert prose-a:text-accent">
    <Content components={{ Sketch }} />
  </article>
</Base>
